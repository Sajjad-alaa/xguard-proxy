#!/bin/sh

# PROVIDE: xguard-proxy
# REQUIRE: NETWORKING wireguard
# KEYWORD: shutdown

. /etc/rc.subr

name="xguard_proxy"
rcvar=xguard_proxy_enable
command="/usr/local/bin/xguard-proxy"
config="/etc/xguard/proxy.toml"
start_cmd="${name}_proxy_start"

xguard_proxy_start() {
	${command} --config ${config} &
}

load_rc_config $name
run_rc_command "$1"
